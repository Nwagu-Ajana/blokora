rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    match /inventory/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    match /leaderboards/{entryId} { allow read: if request.auth != null; allow write: if false; }
    match /matches/{matchId} { allow read: if request.auth != null; allow write: if false; }
    match /seasons/{seasonId} { allow read: if true; allow write: if false; }
  }
}
